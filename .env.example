# CTA Train Tracker API key — get one at https://www.transitchicago.com/developers/traintracker/
CTA_TRAIN_TRACKER_KEY=your_cta_api_key_here

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cta_delays

# How often to poll the CTA Train Tracker API (seconds)
POLL_INTERVAL_SECONDS=25

# GTFS schedule data URL (CTA publishes updates roughly weekly)
GTFS_URL=https://www.transitchicago.com/downloads/sch_data/google_transit.zip

# Directory to persist trained model artifacts
MODEL_DIR=ml_models

# FastAPI backend origin, used by Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
