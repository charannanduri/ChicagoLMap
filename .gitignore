# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/

# Environment variables
.env
*.env
# API key file (git gitignore does not support inline comments on patterns)
api_key.txt

# Claude Code harness config (machine-specific)
.claude/

# Firmware secrets (WiFi credentials, backend host)
firmware/**/secrets.h

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# Distribution / packaging
dist/
build/
*.egg-info/

# CTA delay predictor — ML artifacts
cta-delay-predictor/ml_models/
cta-delay-predictor/**/*.joblib

# CTA delay predictor — Node / Next.js
cta-delay-predictor/frontend/node_modules/
cta-delay-predictor/frontend/.next/
cta-delay-predictor/frontend/out/

# CTA delay predictor — environment
cta-delay-predictor/.env

# Python cache
__pycache__/
*.pyc

# Jupyter checkpoints
.ipynb_checkpoints/

# Parquet / CSV data exports
*.parquet
*.csv